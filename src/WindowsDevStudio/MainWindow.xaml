
<Window x:Class="WindowsDevStudio.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Windows Dev Studio"
        Height="850"
        Width="1450"
        MinHeight="650"
        MinWidth="1000"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource AppBackground}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="60"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="28"/>
        </Grid.RowDefinitions>

        <!-- Top Toolbar -->
        <Border Grid.Row="0"
                Background="#171B22"
                BorderBrush="{StaticResource PanelBorder}"
                BorderThickness="0,0,0,1">

            <DockPanel Margin="15,0">

                <StackPanel Orientation="Horizontal"
                            DockPanel.Dock="Left"
                            VerticalAlignment="Center">

                    <TextBlock Text="WINDOWS DEV STUDIO"
                               FontSize="16"
                               FontWeight="Bold"
                               Foreground="{StaticResource Accent}"
                               VerticalAlignment="Center"
                               Margin="0,0,25,0"/>

                    <Button Content="Open Folder"/>
                    <Button Content="Open File"/>
                    <Button Content="Save File"/>

                </StackPanel>

                <TextBlock Text="Development Workspace"
                           Foreground="{StaticResource MutedText}"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Right"/>

            </DockPanel>
        </Border>

        <!-- Main Workspace -->
        <Grid Grid.Row="1" Margin="10">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="300"/>
            </Grid.ColumnDefinitions>

            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="5"/>
                <RowDefinition Height="210"/>
            </Grid.RowDefinitions>

            <!-- Project Explorer -->
            <Border Grid.Column="0"
                    Grid.Row="0"
                    Grid.RowSpan="3"
                    Background="{StaticResource PanelBackground}"
                    BorderBrush="{StaticResource PanelBorder}"
                    BorderThickness="1"
                    CornerRadius="7"
                    Padding="12">

                <StackPanel>

                    <TextBlock Text="PROJECT EXPLORER"
                               FontWeight="Bold"
                               Foreground="{StaticResource MutedText}"
                               Margin="0,0,0,15"/>

                    <TextBlock Text="No project opened"
                               FontWeight="SemiBold"/>

                    <TextBlock Text="Open a project folder to see your files."
                               Foreground="{StaticResource MutedText}"
                               TextWrapping="Wrap"
                               Margin="0,10,0,0"/>

                </StackPanel>
            </Border>

            <GridSplitter Grid.Column="1"
                          Grid.Row="0"
                          Grid.RowSpan="3"
                          Width="5"
                          HorizontalAlignment="Stretch"
                          Background="#252C38"/>

            <!-- Code Editor -->
            <Border Grid.Column="2"
                    Grid.Row="0"
                    Background="{StaticResource PanelBackground}"
                    BorderBrush="{StaticResource PanelBorder}"
                    BorderThickness="1"
                    CornerRadius="7"
                    Padding="12">

                <Grid>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="35"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="CODE EDITOR"
                               FontWeight="Bold"
                               Foreground="{StaticResource MutedText}"
                               VerticalAlignment="Center"/>

                    <TextBox Grid.Row="1"
                             AcceptsReturn="True"
                             AcceptsTab="True"
                             VerticalScrollBarVisibility="Auto"
                             HorizontalScrollBarVisibility="Auto"
                             TextWrapping="NoWrap"
                             FontFamily="Consolas"
                             FontSize="14"
                             Background="#12161D"
                             Foreground="#DCE4EF"
                             BorderBrush="{StaticResource PanelBorder}"
                             Padding="12"
                             Text="Welcome to Windows Dev Studio&#x0a;&#x0a;Your coding workspace is ready.&#x0a;&#x0a;Open a project to begin."/>

                </Grid>
            </Border>

            <GridSplitter Grid.Column="2"
                          Grid.Row="1"
                          Height="5"
                          HorizontalAlignment="Stretch"
                          Background="#252C38"/>

            <!-- Terminal -->
            <Border Grid.Column="2"
                    Grid.Row="2"
                    Grid.ColumnSpan="3"
                    Background="#111318"
                    BorderBrush="{StaticResource PanelBorder}"
                    BorderThickness="1"
                    CornerRadius="7"
                    Padding="12">

                <StackPanel>

                    <TextBlock Text="TERMINAL"
                               FontWeight="Bold"
                               Foreground="{StaticResource MutedText}"
                               Margin="0,0,0,12"/>

                    <TextBlock Text="Terminal integration will be implemented in the next development stage."
                               Foreground="{StaticResource MutedText}"
                               TextWrapping="Wrap"/>

                </StackPanel>
            </Border>

            <GridSplitter Grid.Column="3"
                          Grid.Row="0"
                          Grid.RowSpan="3"
                          Width="5"
                          HorizontalAlignment="Stretch"
                          Background="#252C38"/>

            <!-- AI Assistant -->
            <Border Grid.Column="4"
                    Grid.Row="0"
                    Background="{StaticResource PanelBackground}"
                    BorderBrush="{StaticResource PanelBorder}"
                    BorderThickness="1"
                    CornerRadius="7"
                    Padding="12">

                <StackPanel>

                    <TextBlock Text="AI ASSISTANT"
                               FontWeight="Bold"
                               Foreground="{StaticResource MutedText}"
                               Margin="0,0,0,15"/>

                    <TextBlock Text="Welcome to AI Coding"
                               FontWeight="SemiBold"
                               Margin="0,0,0,8"/>

                    <TextBlock Text="AI provider connection will be configured in a future update."
                               Foreground="{StaticResource MutedText}"
                               TextWrapping="Wrap"/>

                </StackPanel>
            </Border>

        </Grid>

        <!-- Status Bar -->
        <Border Grid.Row="2"
                Background="#171B22"
                BorderBrush="{StaticResource PanelBorder}"
                BorderThickness="0,1,0,0">

            <DockPanel Margin="12,0">

                <TextBlock Text="Ready"
                           Foreground="{StaticResource MutedText}"
                           VerticalAlignment="Center"/>

                <TextBlock Text=".NET 8 | WPF | Windows"
                           Foreground="{StaticResource MutedText}"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Center"/>

            </DockPanel>
        </Border>

    </Grid>
</Window>
