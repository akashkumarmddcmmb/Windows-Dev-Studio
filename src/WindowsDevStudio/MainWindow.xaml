
<Window x:Class="WindowsDevStudio.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Windows Dev Studio"
        Height="900"
        Width="1500"
        MinHeight="680"
        MinWidth="1050"
        WindowStartupLocation="CenterScreen"
        Background="#0D1118"
        Foreground="#E8EDF5">

    <Window.Resources>

        <SolidColorBrush x:Key="PanelBrush" Color="#151B25"/>
        <SolidColorBrush x:Key="PanelBorderBrush" Color="#293548"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#3988F5"/>
        <SolidColorBrush x:Key="MutedBrush" Color="#91A0B5"/>

        <Style TargetType="Button">
            <Setter Property="Background" Value="#202B3B"/>
            <Setter Property="Foreground" Value="#E8EDF5"/>
            <Setter Property="BorderBrush" Value="#34445B"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="13,8"/>
            <Setter Property="Margin" Value="3"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#304563"/>
                                <Setter Property="BorderBrush" Value="#579BFA"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#173B67"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#E8EDF5"/>
        </Style>

        <Style TargetType="TreeViewItem">
            <Setter Property="Foreground" Value="#D5DFED"/>
            <Setter Property="Padding" Value="3"/>
            <Setter Property="Margin" Value="0,2"/>
        </Style>

    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="48"/>
            <RowDefinition Height="52"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="30"/>
        </Grid.RowDefinitions>

        <!-- APPLICATION HEADER -->

        <Border Grid.Row="0"
                Background="#111824"
                BorderBrush="#293548"
                BorderThickness="0,0,0,1">

            <DockPanel Margin="14,0">

                <StackPanel Orientation="Horizontal"
                            VerticalAlignment="Center">

                    <Border Width="30"
                            Height="30"
                            Background="#1E477A"
                            CornerRadius="7"
                            Margin="0,0,10,0">

                        <TextBlock Text="WDS"
                                   FontSize="10"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Foreground="White"/>
                    </Border>

                    <TextBlock Text="Windows Dev Studio"
                               FontSize="17"
                               FontWeight="Bold"
                               VerticalAlignment="Center"/>

                    <TextBlock Text="  |  Development Workspace"
                               Foreground="#91A0B5"
                               FontSize="11"
                               VerticalAlignment="Center"
                               Margin="10,0,0,0"/>
                </StackPanel>

                <TextBlock DockPanel.Dock="Right"
                           Text="DESKTOP DEVELOPMENT ENVIRONMENT"
                           Foreground="#8192A9"
                           FontSize="10"
                           VerticalAlignment="Center"/>

            </DockPanel>
        </Border>

        <!-- MAIN TOOLBAR -->

        <Border Grid.Row="1"
                Background="#151D29"
                BorderBrush="#293548"
                BorderThickness="0,0,0,1">

            <DockPanel Margin="10,0">

                <StackPanel Orientation="Horizontal"
                            VerticalAlignment="Center">

                    <Button Content="📂  Open Folder"
                            Click="OpenFolder_Click"/>

                    <Button Content="📄  Open File"
                            Click="OpenFile_Click"/>

                    <Button Content="💾  Save"
                            Click="SaveFile_Click"/>

                    <Border Width="1"
                            Height="28"
                            Background="#34445B"
                            Margin="12,0"/>

                    <TextBlock Text="EDITOR"
                               Foreground="#91A0B5"
                               FontSize="11"
                               FontWeight="Bold"
                               VerticalAlignment="Center"/>

                </StackPanel>

                <TextBlock x:Name="WorkspaceName"
                           Text="No Project Open"
                           Foreground="#8FB9F5"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Right"/>

            </DockPanel>
        </Border>

        <!-- MAIN WORKSPACE -->

        <Grid Grid.Row="2" Margin="8">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="245"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="290"/>
            </Grid.ColumnDefinitions>

            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="5"/>
                <RowDefinition Height="225"/>
            </Grid.RowDefinitions>

            <!-- PROJECT EXPLORER -->

            <Border Grid.Column="0"
                    Grid.Row="0"
                    Grid.RowSpan="3"
                    Background="{StaticResource PanelBrush}"
                    BorderBrush="{StaticResource PanelBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="7"
                    Padding="10">

                <DockPanel>

                    <StackPanel DockPanel.Dock="Top">

                        <TextBlock Text="PROJECT EXPLORER"
                                   FontWeight="Bold"
                                   FontSize="12"
                                   Foreground="#9FB2CC"
                                   Margin="5,5,5,12"/>

                        <Border Background="#202B3B"
                                CornerRadius="5"
                                Padding="8"
                                Margin="0,0,0,10">

                            <TextBlock Text="PROJECT FILES"
                                       FontSize="10"
                                       Foreground="#9FB9DC"
                                       FontWeight="SemiBold"/>
                        </Border>

                    </StackPanel>

                    <TreeView x:Name="ProjectTree"
                              Background="Transparent"
                              BorderThickness="0"
                              Foreground="#E8EDF5"
                              FontSize="12"
                              MouseDoubleClick="ProjectTree_MouseDoubleClick"/>

                </DockPanel>
            </Border>

            <GridSplitter Grid.Column="1"
                          Grid.Row="0"
                          Grid.RowSpan="3"
                          Width="5"
                          HorizontalAlignment="Stretch"
                          Background="#26364B"/>

            <!-- CODE EDITOR -->

            <Border Grid.Column="2"
                    Grid.Row="0"
                    Background="{StaticResource PanelBrush}"
                    BorderBrush="{StaticResource PanelBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="7"
                    Padding="0">

                <Grid>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="42"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Background="#1A2432"
                            BorderBrush="#293548"
                            BorderThickness="0,0,0,1"
                            CornerRadius="7,7,0,0">

                        <DockPanel Margin="12,0">

                            <TextBlock Text="◈"
                                       Foreground="#59A5FF"
                                       FontSize="16"
                                       VerticalAlignment="Center"
                                       Margin="0,0,9,0"/>

                            <TextBlock x:Name="EditorFileName"
                                       Text="Welcome"
                                       FontWeight="SemiBold"
                                       FontSize="12"
                                       VerticalAlignment="Center"/>

                            <TextBlock Text="  ●"
                                       Foreground="#53C98B"
                                       VerticalAlignment="Center"
                                       Margin="8,0,0,0"/>

                        </DockPanel>
                    </Border>

                    <TextBox x:Name="EditorText"
                             Grid.Row="1"
                             AcceptsReturn="True"
                             AcceptsTab="True"
                             VerticalScrollBarVisibility="Auto"
                             HorizontalScrollBarVisibility="Auto"
                             TextWrapping="NoWrap"
                             FontFamily="Consolas"
                             FontSize="14"
                             Background="#10151E"
                             Foreground="#DCE7F5"
                             CaretBrush="#65A9FF"
                             SelectionBrush="#315D91"
                             BorderThickness="0"
                             Padding="16"
                             SpellCheck.IsEnabled="False"
                             Text="Welcome to Windows Dev Studio.&#x0a;&#x0a;Open a project folder to start working.&#x0a;&#x0a;Your code editor is ready."/>

                </Grid>
            </Border>

            <GridSplitter Grid.Column="2"
                          Grid.Row="1"
                          Height="5"
                          HorizontalAlignment="Stretch"
                          Background="#26364B"/>

            <!-- TERMINAL PANEL -->

            <Border Grid.Column="2"
                    Grid.Row="2"
                    Background="#10151E"
                    BorderBrush="{StaticResource PanelBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="7"
                    Padding="8">

                <Grid>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="38"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="36"/>
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0">

                        <TextBlock Text="TERMINAL"
                                   FontWeight="Bold"
                                   FontSize="12"
                                   Foreground="#A9BAD0"
                                   VerticalAlignment="Center"
                                   Margin="5,0,15,0"/>

                        <TextBlock x:Name="TerminalShellLabel"
                                   Text="PowerShell"
                                   Foreground="#61A8FF"
                                   FontSize="11"
                                   VerticalAlignment="Center"/>

                        <StackPanel Orientation="Horizontal"
                                    DockPanel.Dock="Right">

                            <Button Content="PowerShell"
                                    Click="PowerShell_Click"
                                    Padding="9,5"/>

                            <Button Content="CMD"
                                    Click="CommandPrompt_Click"
                                    Padding="12,5"/>

                            <Button Content="Clear"
                                    Click="ClearTerminal_Click"
                                    Padding="9,5"/>

                        </StackPanel>

                    </DockPanel>

                    <TextBox x:Name="TerminalOutput"
                             Grid.Row="1"
                             IsReadOnly="True"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto"
                             HorizontalScrollBarVisibility="Auto"
                             FontFamily="Consolas"
                             FontSize="12"
                             Background="#0B1018"
                             Foreground="#D5E1EF"
                             BorderThickness="0"
                             Padding="8"
                             IsTabStop="False"/>

                    <Border Grid.Row="2"
                            Background="#1A2432"
                            BorderBrush="#34445B"
                            BorderThickness="1"
                            CornerRadius="5"
                            Margin="0,5,0,0">

                        <DockPanel>

                            <TextBlock Text="›"
                                       FontSize="20"
                                       FontWeight="Bold"
                                       Foreground="#60A9FF"
                                       VerticalAlignment="Center"
                                       Margin="10,0,8,0"/>

                            <TextBox x:Name="TerminalInput"
                                     Background="Transparent"
                                     Foreground="White"
                                     BorderThickness="0"
                                     FontFamily="Consolas"
                                     FontSize="13"
                                     VerticalContentAlignment="Center"
                                     CaretBrush="White"
                                     KeyDown="TerminalInput_KeyDown"/>

                        </DockPanel>
                    </Border>

                </Grid>
            </Border>

            <GridSplitter Grid.Column="3"
                          Grid.Row="0"
                          Grid.RowSpan="3"
                          Width="5"
                          HorizontalAlignment="Stretch"
                          Background="#26364B"/>

            <!-- AI ASSISTANT PANEL -->

            <Border Grid.Column="4"
                    Grid.Row="0"
                    Grid.RowSpan="3"
                    Background="{StaticResource PanelBrush}"
                    BorderBrush="{StaticResource PanelBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="7"
                    Padding="12">

                <Grid>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="42"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Border Background="#1A2432"
                            CornerRadius="5"
                            Padding="9">

                        <TextBlock Text="AI CODING ASSISTANT"
                                   FontWeight="Bold"
                                   FontSize="12"
                                   Foreground="#9FC5F5"
                                   VerticalAlignment="Center"/>

                    </Border>

                    <StackPanel Grid.Row="1"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Center"
                                Margin="8">

                        <Border Width="76"
                                Height="76"
                                CornerRadius="38"
                                Background="#203B60"
                                HorizontalAlignment="Center"
                                Margin="0,0,0,18">

                            <TextBlock Text="AI"
                                       FontSize="28"
                                       FontWeight="Bold"
                                       Foreground="#82BBFF"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>

                        </Border>

                        <TextBlock Text="Your AI Coding Partner"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   TextAlignment="Center"
                                   Margin="0,0,0,10"/>

                        <TextBlock Text="Get help with code, understand errors and plan your development work."
                                   Foreground="{StaticResource MutedBrush}"
                                   FontSize="12"
                                   TextWrapping="Wrap"
                                   TextAlignment="Center"
                                   LineHeight="20"/>

                        <Border Background="#202B3B"
                                CornerRadius="6"
                                Padding="10"
                                Margin="0,22,0,0">

                            <TextBlock Text="AI provider setup will be available in Settings. No paid service is activated automatically."
                                       FontSize="11"
                                       Foreground="#B4C6DD"
                                       TextWrapping="Wrap"
                                       TextAlignment="Center"/>

                        </Border>

                    </StackPanel>

                    <Border Grid.Row="2"
                            Background="#1A2432"
                            CornerRadius="5"
                            Padding="10">

                        <TextBlock Text="AI CONNECTION NOT CONFIGURED"
                                   Foreground="#D5A85C"
                                   FontSize="10"
                                   FontWeight="SemiBold"
                                   TextAlignment="Center"/>

                    </Border>

                </Grid>
            </Border>

        </Grid>

        <!-- STATUS BAR -->

        <Border Grid.Row="3"
                Background="#14243A"
                BorderBrush="#293F5D"
                BorderThickness="0,1,0,0">

            <DockPanel Margin="12,0">

                <StackPanel Orientation="Horizontal"
                            VerticalAlignment="Center">

                    <Ellipse Width="8"
                             Height="8"
                             Fill="#4CCB88"
                             Margin="0,0,8,0"/>

                    <TextBlock x:Name="StatusText"
                               Text="Ready"
                               FontSize="11"
                               Foreground="#D7E5F7"
                               VerticalAlignment="Center"/>

                </StackPanel>

                <TextBlock Text=".NET 8  |  WPF  |  Windows x64"
                           Foreground="#A9BAD0"
                           FontSize="11"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Right"/>

            </DockPanel>
        </Border>

    </Grid>
</Window>
