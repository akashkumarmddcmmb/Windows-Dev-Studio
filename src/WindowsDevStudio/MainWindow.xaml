
<Window x:Class="WindowsDevStudio.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Windows Dev Studio"
        Height="850"
        Width="1450"
        MinHeight="650"
        MinWidth="1000"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource AppBackground}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="60"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="28"/>
        </Grid.RowDefinitions>

        <!-- Toolbar -->
        <Border Grid.Row="0"
                Background="#171B22"
                BorderBrush="{StaticResource PanelBorder}"
                BorderThickness="0,0,0,1">
            <DockPanel Margin="15,0">
                <StackPanel Orientation="Horizontal"
                            DockPanel.Dock="Left"
                            VerticalAlignment="Center">
                    <TextBlock Text="WINDOWS DEV STUDIO"
                               FontSize="16"
                               FontWeight="Bold"
                               Foreground="{StaticResource Accent}"
                               VerticalAlignment="Center"
                               Margin="0,0,25,0"/>

                    <Button Content="Open Folder"
                            Click="OpenFolder_Click"
                            Margin="0,0,8,0"/>

                    <Button Content="Open File"
                            Click="OpenFile_Click"
                            Margin="0,0,8,0"/>

                    <Button Content="Save File"
                            Click="SaveFile_Click"/>
                </StackPanel>

                <TextBlock x:Name="WorkspaceName"
                           Text="Development Workspace"
                           Foreground="{StaticResource MutedText}"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Right"/>
            </DockPanel>
        </Border>

        <!-- Workspace -->
        <Grid Grid.Row="1" Margin="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="300"/>
            </Grid.ColumnDefinitions>

            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="5"/>
                <RowDefinition Height="235"/>
            </Grid.RowDefinitions>

            <!-- Project Explorer -->
            <Border Grid.Column="0"
                    Grid.Row="0"
                    Grid.RowSpan="3"
                    Background="{StaticResource PanelBackground}"
                    BorderBrush="{StaticResource PanelBorder}"
                    BorderThickness="1"
                    CornerRadius="7"
                    Padding="12">

                <DockPanel>
                    <TextBlock Text="PROJECT EXPLORER"
                               DockPanel.Dock="Top"
                               FontWeight="Bold"
                               Foreground="{StaticResource MutedText}"
                               Margin="0,0,0,12"/>

                    <TreeView x:Name="ProjectTree"
                              Background="Transparent"
                              BorderThickness="0"
                              Foreground="{StaticResource PrimaryText}"
                              MouseDoubleClick="ProjectTree_MouseDoubleClick"/>
                </DockPanel>
            </Border>

            <GridSplitter Grid.Column="1"
                          Grid.Row="0"
                          Grid.RowSpan="3"
                          Width="5"
                          HorizontalAlignment="Stretch"
                          Background="#252C38"/>

            <!-- Editor -->
            <Border Grid.Column="2"
                    Grid.Row="0"
                    Background="{StaticResource PanelBackground}"
                    BorderBrush="{StaticResource PanelBorder}"
                    BorderThickness="1"
                    CornerRadius="7"
                    Padding="12">

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="35"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock x:Name="EditorFileName"
                               Text="CODE EDITOR"
                               FontWeight="Bold"
                               Foreground="{StaticResource MutedText}"
                               VerticalAlignment="Center"/>

                    <TextBox x:Name="EditorText"
                             Grid.Row="1"
                             AcceptsReturn="True"
                             AcceptsTab="True"
                             VerticalScrollBarVisibility="Auto"
                             HorizontalScrollBarVisibility="Auto"
                             TextWrapping="NoWrap"
                             FontFamily="Consolas"
                             FontSize="14"
                             Background="#12161D"
                             Foreground="#DCE4EF"
                             BorderBrush="{StaticResource PanelBorder}"
                             Padding="12"
                             SpellCheck.IsEnabled="False"
                             Text="Welcome to Windows Dev Studio&#x0a;&#x0a;Your coding workspace is ready.&#x0a;&#x0a;Open a project to begin."/>
                </Grid>
            </Border>

            <GridSplitter Grid.Column="2"
                          Grid.Row="1"
                          Height="5"
                          HorizontalAlignment="Stretch"
                          Background="#252C38"/>

            <!-- Real Windows Terminal -->
            <Border Grid.Column="2"
                    Grid.Row="2"
                    Background="#111318"
                    BorderBrush="{StaticResource PanelBorder}"
                    BorderThickness="1"
                    CornerRadius="7"
                    Padding="10">

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="34"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="36"/>
                    </Grid.RowDefinitions>

                    <!-- Terminal Toolbar -->
                    <DockPanel Grid.Row="0"
                               LastChildFill="False">

                        <TextBlock Text="TERMINAL"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource MutedText}"
                                   VerticalAlignment="Center"
                                   Margin="0,0,12,0"/>

                        <TextBlock x:Name="TerminalShellLabel"
                                   Text="PowerShell"
                                   Foreground="{StaticResource Accent}"
                                   VerticalAlignment="Center"
                                   Margin="0,0,12,0"/>

                        <StackPanel Orientation="Horizontal"
                                    DockPanel.Dock="Right">

                            <Button Content="PowerShell"
                                    Click="PowerShell_Click"
                                    Margin="0,0,6,0"
                                    Padding="8,3"/>

                            <Button Content="CMD"
                                    Click="CommandPrompt_Click"
                                    Margin="0,0,6,0"
                                    Padding="8,3"/>

                            <Button Content="Clear"
                                    Click="ClearTerminal_Click"
                                    Padding="8,3"/>
                        </StackPanel>
                    </DockPanel>

                    <!-- Terminal Output -->
                    <TextBox x:Name="TerminalOutput"
                             Grid.Row="1"
                             IsReadOnly="True"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto"
                             HorizontalScrollBarVisibility="Auto"
                             FontFamily="Consolas"
                             FontSize="12"
                             Background="#0B0D11"
                             Foreground="#DCE4EF"
                             BorderThickness="0"
                             Padding="6"
                             IsTabStop="False"/>

                    <!-- Terminal Input -->
                    <Border Grid.Row="2"
                            Background="#191E27"
                            BorderBrush="{StaticResource PanelBorder}"
                            BorderThickness="1"
                            CornerRadius="4"
                            Margin="0,5,0,0">

                        <DockPanel>
                            <TextBlock Text="&gt;"
                                       Foreground="{StaticResource Accent}"
                                       FontFamily="Consolas"
                                       FontSize="14"
                                       FontWeight="Bold"
                                       VerticalAlignment="Center"
                                       Margin="10,0,8,0"/>

                            <TextBox x:Name="TerminalInput"
                                     Background="Transparent"
                                     Foreground="#FFFFFF"
                                     BorderThickness="0"
                                     FontFamily="Consolas"
                                     FontSize="13"
                                     VerticalContentAlignment="Center"
                                     CaretBrush="White"
                                     KeyDown="TerminalInput_KeyDown"/>
                        </DockPanel>
                    </Border>
                </Grid>
            </Border>

            <GridSplitter Grid.Column="3"
                          Grid.Row="0"
                          Grid.RowSpan="3"
                          Width="5"
                          HorizontalAlignment="Stretch"
                          Background="#252C38"/>

            <!-- AI Assistant -->
            <Border Grid.Column="4"
                    Grid.Row="0"
                    Background="{StaticResource PanelBackground}"
                    BorderBrush="{StaticResource PanelBorder}"
                    BorderThickness="1"
                    CornerRadius="7"
                    Padding="12">

                <StackPanel>
                    <TextBlock Text="AI ASSISTANT"
                               FontWeight="Bold"
                               Foreground="{StaticResource MutedText}"
                               Margin="0,0,0,15"/>

                    <TextBlock Text="Welcome to AI Coding"
                               FontWeight="SemiBold"
                               Margin="0,0,0,8"/>

                    <TextBlock Text="AI provider connection will be configured after secure provider settings are implemented."
                               Foreground="{StaticResource MutedText}"
                               TextWrapping="Wrap"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Status Bar -->
        <Border Grid.Row="2"
                Background="#171B22"
                BorderBrush="{StaticResource PanelBorder}"
                BorderThickness="0,1,0,0">

            <DockPanel Margin="12,0">
                <TextBlock x:Name="StatusText"
                           Text="Ready"
                           Foreground="{StaticResource MutedText}"
                           VerticalAlignment="Center"/>

                <TextBlock Text=".NET 8 | WPF | Windows"
                           Foreground="{StaticResource MutedText}"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Center"/>
            </DockPanel>
        </Border>
    </Grid>
</Window>
